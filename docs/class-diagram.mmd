classDiagram
direction LR

namespace Controller {
  class Main {
    +main(String[] args)$
    ~appDirectory() File$
  }
  class MainController {
    -MainFrame frame
    -SetupController setupController
    -GameController gameController
    -HistoryController historyController
    +start()
    +showMenu()
    +showSetup()
    +showHistory()
    +startGame(GameSettings settings)
    +showGameOver(List~Player~ ranking, String duration, String difficulty, String note)
    +requestLeaveGame()
    +requestQuit()
  }
  class SetupController {
    -GameSetupPanel view
    -MainController main
    ~bind()
    -onStart()
  }
  class GameController {
    -MainFrame frame
    -GameScreenPanel view
    -HistoryRepository history
    -Game game
    -Timer clock
    +start(GameSettings settings)
