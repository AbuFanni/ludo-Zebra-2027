namespace Model {
  class Difficulty {
    <<enumeration>>
    EASY
    MEDIUM
    HARD
    +getGridSize() int
    +getOuterRings() int
    +getSafeSquares() int
    +getQuestionsPerLevel() int
    +getSurpriseSquares() int
    +getCsvName() String
  }
  class PlayerColor {
    <<enumeration>>
    GREEN
    YELLOW
    BLUE
    RED
    +getQuarterTurns() int
  }
  class Position {
    -int row
    -int col
    +rotate(int size, int quarterTurns) Position
    +plus(int dRow, int dCol) Position
  }
  class Square {
    <<abstract>>
    -Position position
    -PlayerColor owner
    +getKind() SquareKind*
    +isSafe() boolean*
    +isPrivate() boolean
  }
  class SquareKind {
    <<enumeration>>
    REGULAR
    SAFE
    START
    ARROW
    HOME_PATH
    FINISH
    QUESTION
    SURPRISE
  }
  class RegularSquare
  class SafeSquare
  class StartSquare
  class ArrowSquare
  class HomePathSquare
  class FinishSquare
  class QuestionSquare {
    -QuestionLevel level
  }
  class SurpriseSquare
  class QuestionLevel {
    <<enumeration>>
    EASY
    MEDIUM
    HARD
    +getSteps() int
  }
  class SquareFactory {
    +create(SquareKind k, Position p, PlayerColor owner, QuestionLevel l) Square$
  }
  class BoardBuilder {
    +build(Difficulty d, Random r) Board$
    ~ring(int n, int k) List~Position~$
    ~innerGreenTrack() List~Position~$
  }
