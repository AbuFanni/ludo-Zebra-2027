Game ..> Move
Game ..> RollResult
Game ..> MoveResult
Die <|.. StepDie
Player "1" *-- "4" Pawn
Player --> PlayerColor
Move --> Pawn
GameSetupValidator ..> SetupValidationResult
SetupValidationResult --> GameSettings
GameSettings ..> Player : creates
HistoryRepository ..> GameRecord
HistoryRepository ..> Game
